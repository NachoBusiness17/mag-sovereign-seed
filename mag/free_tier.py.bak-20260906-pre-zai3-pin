def status() -> dict[str, Any]:
    """Who's alive right now: key present + not dead, with real lane telemetry folded in."""
    _env()
    profile = _lane_profile()
    rows = {}
    for s in FREE_SURFACES:
        key_ok = _key_present(s.get("keys", [])) if s.get("keys") else True
        tele = profile.get(s["id"], {})
        ok_rate = None
        fails = []
        if tele:
            calls = int(tele.get("calls", 0))
            ok = int(tele.get("ok", 0))
            ok_rate = round(ok / calls, 3) if calls else None
            fails = [e for e in (tele.get("errors") or [])][:2]
        rows[s["id"]] = {
            "key_present": key_ok,
            "kind": s.get("kind"),
            "speed": s.get("speed"),
            "strength": s.get("strength"),
            "ok_rate": ok_rate,
            "fail_hints": fails,
            "best_for": s.get("best_for", []),
        }
    return {"ok": True, "schema": "free_tier.v1", "n_surfaces": len(FREE_SURFACES), "surfaces": rows}


def route(intent: str) -> list[str]:
    """Best free surface(s) for an intent, SKIPPING dead/dying/exhausted bodies."""
    _env()
    profile = _lane_profile()
    intent = (intent or "").lower()
    alive = []
    for s in FREE_SURFACES:
        if s.get("keys") and not _key_present(s.get("keys", [])):
            continue  # no key -> not alive
        tele = profile.get(s["id"], {})
        calls = int(tele.get("calls", 0))
        ok = int(tele.get("ok", 0))
        if calls >= 5 and ok / calls < 0.5:
            continue  # dying/exhausted (real telemetry)
        alive.append(s)

    def _ok(s: dict) -> float:
        tele = profile.get(s["id"], {})
        calls = int(tele.get("calls", 0))
        if not calls:
            return 0.0  # no telemetry yet — treated as fresh/unknown, not best
        return int(tele.get("ok", 0)) / calls

    def pick(ordered_kinds: tuple[str, ...], n: int = 2) -> list[str]:
        """Order by KIND first (the intent's specialty), then by reliability within kind."""
        def key(s: dict):
            kind = s["kind"]
            idx = ordered_kinds.index(kind) if kind in ordered_kinds else len(ordered_kinds)
            return (idx, -_ok(s), s["id"])
        ordered = sorted(alive, key=key)
        return [s["id"] for s in ordered[:n]]

    if any(k in intent for k in ("fast", "speed")):
        return pick(("fast",))
    if any(k in intent for k in ("reason", "deep", "frontier")):
        return pick(("reasoning", "frontier", "strong"), n=2)
    if any(k in intent for k in ("cache", "cheap", "daily", "bulk", "agentic")):
        return pick(("cache_mining", "fast", "bulk"), n=2)
    if any(k in intent for k in ("code", "coding", "build")):
        return pick(("frontier", "strong", "cache_mining"), n=2)
    if any(k in intent for k in ("local", "private")):
        return pick(("local",))
    return pick(("cache_mining", "fast", "strong"), n=2)


